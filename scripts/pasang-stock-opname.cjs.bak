#!/usr/bin/env node
'use strict'
/**
 * Kuki Bakehouse — Perbaikan installer Stock Opname.
 * Simpan sebagai E:\Ekosistem-kuki\scripts\pasang-stock-opname.cjs
 * Lokasi backend/frontend ditentukan dari folder SCRIPT, bukan terminal.
 * --cek untuk pratinjau tanpa mengubah file.
 * Tidak memerlukan folder paket ZIP. Tidak menimpa file modul yang sudah ada.
 */
const fs = require('node:fs')
const path = require('node:path')
const VERSION = 'KUKI_OPNAME_SCRIPT_DIPERBAIKI_20261024'
const args = process.argv.slice(2)
const cek = args.includes('--cek')
if (args.some(a => a !== '--cek')) {
  console.error('Argumen tidak dikenal. Gunakan --cek atau tanpa argumen; tidak perlu mengisi path.')
  process.exit(1)
}
const root = path.resolve(__dirname, '..')
const backend = path.join(root, 'backend-web-katalog')
const frontend = path.join(root, 'web-katalog')
const files = {
  api: path.join(backend, 'routes', 'api.php'),
  app: path.join(frontend, 'src', 'App.jsx'),
  mutasi: path.join(backend, 'app', 'Http', 'Controllers', 'Api', 'MutasiStokController.php'),
  riwayat: path.join(frontend, 'src', 'pages', 'admin', 'RiwayatStokPage.jsx'),
}
const embedded = {"backend/app/Models/OpnameStok.php": "<?php\n\nnamespace App\\Models;\n\nuse Illuminate\\Database\\Eloquent\\Model;\n\nclass OpnameStok extends Model\n{\n    protected $table = 'opname_stok';\n\n    protected $fillable = ['status', 'catatan', 'dibuat_oleh_id', 'diselesaikan_oleh_id', 'diselesaikan_pada'];\n\n    protected $casts = ['diselesaikan_pada' => 'datetime'];\n\n    public function detail()\n    {\n        return $this->hasMany(OpnameStokDetail::class, 'opname_id');\n    }\n\n    public function pembuat()\n    {\n        return $this->belongsTo(User::class, 'dibuat_oleh_id');\n    }\n\n    public function penyelesai()\n    {\n        return $this->belongsTo(User::class, 'diselesaikan_oleh_id');\n    }\n}\n", "backend/app/Models/OpnameStokDetail.php": "<?php\n\nnamespace App\\Models;\n\nuse Illuminate\\Database\\Eloquent\\Model;\n\nclass OpnameStokDetail extends Model\n{\n    protected $table = 'opname_stok_detail';\n\n    protected $fillable = ['opname_id', 'produk_id', 'stok_sistem', 'stok_fisik', 'catatan'];\n\n    protected $casts = ['stok_sistem' => 'integer', 'stok_fisik' => 'integer'];\n\n    public function opname()\n    {\n        return $this->belongsTo(OpnameStok::class, 'opname_id');\n    }\n\n    public function produk()\n    {\n        return $this->belongsTo(produk::class, 'produk_id');\n    }\n}\n", "backend/app/Http/Controllers/Api/StockOpnameController.php": "<?php\n\nnamespace App\\Http\\Controllers\\Api;\n\nuse App\\Http\\Controllers\\Controller;\nuse App\\Models\\MutasiStok;\nuse App\\Models\\OpnameStok;\nuse App\\Models\\OpnameStokDetail;\nuse App\\Models\\produk;\nuse Illuminate\\Http\\JsonResponse;\nuse Illuminate\\Http\\Request;\nuse Illuminate\\Support\\Facades\\DB;\nuse Illuminate\\Validation\\ValidationException;\n\n/** Stock opname per sesi; GET dapat dibaca Owner, semua mutasi hanya Admin. */\nclass StockOpnameController extends Controller\n{\n    private const MAX_STOK = 4294967295;\n\n    public function index(Request $request): JsonResponse\n    {\n        $filter = $request->validate([\n            'status' => ['nullable', 'in:draft,selesai,dibatalkan'],\n            'page' => ['nullable', 'integer', 'min:1'],\n        ]);\n        $query = OpnameStok::query()->with(['pembuat:id,name', 'penyelesai:id,name'])->withCount('detail');\n        if (isset($filter['status'])) $query->where('status', $filter['status']);\n        $page = $query->orderByDesc('id')->paginate(15);\n        return response()->json(['success' => true, 'data' => [\n            'items' => $page->getCollection()->map(fn (OpnameStok $opname) => $this->ringkasan($opname))->values(),\n            'page' => $page->currentPage(),\n            'last_page' => $page->lastPage(),\n            'total' => $page->total(),\n        ]]);\n    }\n\n    public function show(OpnameStok $opnameStok): JsonResponse\n    {\n        $opnameStok->load(['pembuat:id,name', 'penyelesai:id,name', 'detail.produk:id,nama_produk,barcode,stok']);\n        return response()->json(['success' => true, 'data' => [\n            ...$this->ringkasan($opnameStok),\n            'catatan' => $opnameStok->catatan,\n            'items' => $opnameStok->detail->sortBy('produk_id')->values()->map(fn (OpnameStokDetail $item) => [\n                'id' => $item->id,\n                'produk_id' => $item->produk_id,\n                'nama_produk' => $item->produk?->nama_produk ?? 'Produk tidak ditemukan',\n                'barcode' => $item->produk?->barcode,\n                'stok_sistem' => $item->stok_sistem,\n                'stok_saat_ini' => $item->produk?->stok,\n                'stok_fisik' => $item->stok_fisik,\n                'selisih' => $item->stok_fisik === null ? null : $item->stok_fisik - $item->stok_sistem,\n                'catatan' => $item->catatan,\n            ]),\n        ]]);\n    }\n\n    public function store(Request $request): JsonResponse\n    {\n        $data = $request->validate([\n            'produk_ids' => ['required', 'array', 'min:1', 'max:100'],\n            'produk_ids.*' => ['required', 'integer', 'distinct', 'exists:katalog_produk,id'],\n            'catatan' => ['nullable', 'string', 'max:1000'],\n        ]);\n        $ids = collect($data['produk_ids'])->map(fn ($id) => (int) $id)->sort()->values()->all();\n        $opname = DB::transaction(function () use ($request, $ids, $data) {\n            $items = produk::query()->whereIn('id', $ids)->orderBy('id')->lockForUpdate()->get(['id', 'stok']);\n            if ($items->count() !== count($ids)) throw ValidationException::withMessages(['produk_ids' => ['Ada produk yang tidak ditemukan.']]);\n            $opname = OpnameStok::create([\n                'status' => 'draft',\n                'catatan' => trim((string) ($data['catatan'] ?? '')) ?: null,\n                'dibuat_oleh_id' => $request->user()?->getAuthIdentifier(),\n            ]);\n            foreach ($items as $item) {\n                OpnameStokDetail::create([\n                    'opname_id' => $opname->id,\n                    'produk_id' => $item->id,\n                    'stok_sistem' => (int) ($item->stok ?? 0),\n                ]);\n            }\n            return $opname;\n        });\n        return response()->json(['success' => true, 'message' => 'Sesi stock opname dibuat.', 'data' => ['id' => $opname->id]], 201);\n    }\n\n    /** Simpan penghitungan fisik; belum mengubah stok sistem. */\n    public function update(Request $request, OpnameStok $opnameStok): JsonResponse\n    {\n        $data = $request->validate([\n            'items' => ['required', 'array', 'min:1', 'max:100'],\n            'items.*.id' => ['required', 'integer', 'distinct'],\n            'items.*.stok_fisik' => ['required', 'integer', 'min:0', 'max:'.self::MAX_STOK],\n            'items.*.catatan' => ['nullable', 'string', 'max:400'],\n        ]);\n        DB::transaction(function () use ($opnameStok, $data) {\n            $opname = OpnameStok::query()->lockForUpdate()->findOrFail($opnameStok->id);\n            if ($opname->status !== 'draft') throw ValidationException::withMessages(['items' => ['Sesi opname sudah selesai atau dibatalkan.']]);\n            $rows = OpnameStokDetail::query()->where('opname_id', $opname->id)->lockForUpdate()->get()->keyBy('id');\n            if ($rows->count() !== count($data['items'])) {\n                throw ValidationException::withMessages(['items' => ['Semua produk dalam sesi harus dihitung dan disimpan bersama.']]);\n            }\n            foreach ($data['items'] as $input) {\n                $row = $rows->get((int) $input['id']);\n                if (! $row) throw ValidationException::withMessages(['items' => ['Ada detail opname yang tidak valid.']]);\n                $row->update([\n                    'stok_fisik' => (int) $input['stok_fisik'],\n                    'catatan' => trim((string) ($input['catatan'] ?? '')) ?: null,\n                ]);\n            }\n        });\n        return response()->json(['success' => true, 'message' => 'Hasil hitung fisik disimpan; stok sistem belum berubah.']);\n    }\n\n    /** Posting atomik; tolak jika stok berubah sejak sesi dibuat. */\n    public function selesai(Request $request, OpnameStok $opnameStok): JsonResponse\n    {\n        $changed = DB::transaction(function () use ($request, $opnameStok) {\n            $opname = OpnameStok::query()->lockForUpdate()->findOrFail($opnameStok->id);\n            if ($opname->status !== 'draft') throw ValidationException::withMessages(['status' => ['Sesi sudah diproses.']]);\n            $details = OpnameStokDetail::query()->where('opname_id', $opname->id)->orderBy('produk_id')->lockForUpdate()->get();\n            if ($details->isEmpty() || $details->contains(fn ($row) => $row->stok_fisik === null)) {\n                throw ValidationException::withMessages(['stok_fisik' => ['Semua stok fisik harus diisi dan disimpan sebelum finalisasi.']]);\n            }\n            $items = produk::query()->whereIn('id', $details->pluck('produk_id'))->orderBy('id')->lockForUpdate()->get()->keyBy('id');\n            $total = 0;\n            foreach ($details as $row) {\n                $item = $items->get($row->produk_id);\n                if (! $item || (int) ($item->stok ?? 0) !== (int) $row->stok_sistem) {\n                    throw ValidationException::withMessages(['stok' => [\n                        'Stok berubah setelah draft dibuat (produk ID '.$row->produk_id.'). Batalkan sesi dan buat opname baru agar data aman.',\n                    ]]);\n                }\n            }\n            foreach ($details as $row) {\n                $item = $items->get($row->produk_id);\n                $sebelum = (int) $item->stok;\n                $sesudah = (int) $row->stok_fisik;\n                $selisih = $sesudah - $sebelum;\n                if ($selisih === 0) continue; // Tanpa perubahan stok, tak perlu menulis mutasi.\n                $item->stok = $sesudah;\n                $item->save();\n                MutasiStok::create([\n                    'produk_id' => $item->id,\n                    'pengguna_id' => $request->user()?->getAuthIdentifier(),\n                    'jenis' => 'opname',\n                    'perubahan' => $selisih,\n                    'stok_sebelum' => $sebelum,\n                    'stok_sesudah' => $sesudah,\n                    'keterangan' => 'Selisih stock opname #'.$opname->id.($row->catatan ? ': '.$row->catatan : ''),\n                    'referensi_tipe' => 'opname_stok',\n                    'referensi_id' => $opname->id,\n                ]);\n                $total++;\n            }\n            $opname->update([\n                'status' => 'selesai',\n                'diselesaikan_oleh_id' => $request->user()?->getAuthIdentifier(),\n                'diselesaikan_pada' => now('Asia/Jakarta'),\n            ]);\n            return $total;\n        });\n        return response()->json(['success' => true, 'message' => \"Stock opname diselesaikan. {$changed} produk mengalami perubahan stok.\"]);\n    }\n\n    public function batalkan(OpnameStok $opnameStok): JsonResponse\n    {\n        DB::transaction(function () use ($opnameStok) {\n            $opname = OpnameStok::query()->lockForUpdate()->findOrFail($opnameStok->id);\n            if ($opname->status !== 'draft') throw ValidationException::withMessages(['status' => ['Hanya sesi draft yang bisa dibatalkan.']]);\n            $opname->update(['status' => 'dibatalkan']);\n        });\n        return response()->json(['success' => true, 'message' => 'Sesi opname dibatalkan. Stok tidak berubah.']);\n    }\n\n    /** Pengeluaran dari stok aktif untuk produk rusak/kedaluwarsa, melalui satu transaksi. */\n    public function pengeluaran(Request $request): JsonResponse\n    {\n        $data = $request->validate([\n            'produk_id' => ['required', 'integer', 'exists:katalog_produk,id'],\n            'jenis' => ['required', 'in:rusak,kedaluwarsa'],\n            'stok_sebelum' => ['required', 'integer', 'min:0', 'max:'.self::MAX_STOK],\n            'jumlah' => ['required', 'integer', 'min:1', 'max:'.self::MAX_STOK],\n            'keterangan' => ['required', 'string', 'min:8', 'max:450'],\n            'tanggal_kedaluwarsa' => ['nullable', 'date_format:Y-m-d', 'required_if:jenis,kedaluwarsa'],\n        ]);\n        $row = DB::transaction(function () use ($request, $data) {\n            $item = produk::query()->lockForUpdate()->findOrFail($data['produk_id']);\n            $sebelum = (int) ($item->stok ?? 0);\n            if ($sebelum !== (int) $data['stok_sebelum']) throw ValidationException::withMessages(['stok_sebelum' => ['Stok berubah, muat ulang sebelum menyimpan.']]);\n            $jumlah = (int) $data['jumlah'];\n            if ($jumlah > $sebelum) throw ValidationException::withMessages(['jumlah' => ['Jumlah tidak boleh melebihi stok tersedia.']]);\n            $sesudah = $sebelum - $jumlah;\n            $item->stok = $sesudah;\n            $item->save();\n            $keterangan = trim($data['keterangan']);\n            if ($data['jenis'] === 'kedaluwarsa') $keterangan .= ' | Kedaluwarsa: '.$data['tanggal_kedaluwarsa'];\n            return MutasiStok::create([\n                'produk_id' => $item->id,\n                'pengguna_id' => $request->user()?->getAuthIdentifier(),\n                'jenis' => $data['jenis'],\n                'perubahan' => -$jumlah,\n                'stok_sebelum' => $sebelum,\n                'stok_sesudah' => $sesudah,\n                'keterangan' => $keterangan,\n            ]);\n        });\n        return response()->json(['success' => true, 'message' => 'Pengeluaran barang tersimpan dan tercatat pada Mutasi Stok.', 'data' => ['id' => $row->id]], 201);\n    }\n\n    /** Ringkasan pengeluaran selama bulan berjalan (tanggal WIB). */\n    public function ringkasanPengeluaran(): JsonResponse\n    {\n        $mulai = now('Asia/Jakarta')->startOfMonth()->toDateString();\n        $selesai = now('Asia/Jakarta')->toDateString();\n        $rows = MutasiStok::query()\n            ->selectRaw('jenis, COUNT(*) AS jumlah_kejadian, COALESCE(SUM(-perubahan), 0) AS jumlah_unit')\n            ->whereIn('jenis', ['rusak', 'kedaluwarsa'])\n            ->whereDate('created_at', '>=', $mulai)\n            ->whereDate('created_at', '<=', $selesai)\n            ->groupBy('jenis')->get()->keyBy('jenis');\n        return response()->json(['success' => true, 'data' => [\n            'mulai' => $mulai,\n            'selesai' => $selesai,\n            'rusak' => ['unit' => (int) ($rows->get('rusak')?->jumlah_unit ?? 0), 'kejadian' => (int) ($rows->get('rusak')?->jumlah_kejadian ?? 0)],\n            'kedaluwarsa' => ['unit' => (int) ($rows->get('kedaluwarsa')?->jumlah_unit ?? 0), 'kejadian' => (int) ($rows->get('kedaluwarsa')?->jumlah_kejadian ?? 0)],\n        ]]);\n    }\n\n    private function ringkasan(OpnameStok $opname): array\n    {\n        return [\n            'id' => $opname->id,\n            'status' => $opname->status,\n            'jumlah_produk' => $opname->detail_count ?? $opname->detail?->count() ?? 0,\n            'dibuat_oleh' => $opname->pembuat?->name ?? 'Sistem',\n            'diselesaikan_oleh' => $opname->penyelesai?->name,\n            'dibuat_pada' => $opname->created_at?->toIso8601String(),\n            'diselesaikan_pada' => $opname->diselesaikan_pada?->toIso8601String(),\n        ];\n    }\n}\n", "backend/database/migrations/2026_10_23_233000_create_opname_stok_tables.php": "<?php\n\nuse Illuminate\\Database\\Migrations\\Migration;\nuse Illuminate\\Database\\Schema\\Blueprint;\nuse Illuminate\\Support\\Facades\\Schema;\n\nreturn new class extends Migration {\n    public function up(): void\n    {\n        Schema::create('opname_stok', function (Blueprint $table) {\n            $table->id();\n            $table->string('status', 20)->default('draft'); // draft | selesai | dibatalkan\n            $table->text('catatan')->nullable();\n            $table->foreignId('dibuat_oleh_id')->nullable()->constrained('users')->nullOnDelete();\n            $table->foreignId('diselesaikan_oleh_id')->nullable()->constrained('users')->nullOnDelete();\n            $table->timestamp('diselesaikan_pada')->nullable();\n            $table->timestamps();\n            $table->index(['status', 'created_at']);\n        });\n\n        Schema::create('opname_stok_detail', function (Blueprint $table) {\n            $table->id();\n            $table->foreignId('opname_id')->constrained('opname_stok')->cascadeOnDelete();\n            $table->foreignId('produk_id')->constrained('katalog_produk')->restrictOnDelete();\n            $table->unsignedBigInteger('stok_sistem'); // Snapshot saat draft dibuat\n            $table->unsignedBigInteger('stok_fisik')->nullable();\n            $table->string('catatan', 500)->nullable();\n            $table->timestamps();\n            $table->unique(['opname_id', 'produk_id']);\n        });\n    }\n\n    public function down(): void\n    {\n        Schema::dropIfExists('opname_stok_detail');\n        Schema::dropIfExists('opname_stok');\n    }\n};\n", "frontend/src/services/opnameStokService.js": "import { api } from './api'\n\nconst data = (response) => response?.data?.data ?? response?.data ?? response\n\nexport async function ambilDaftarOpname({ status = '', page = 1 } = {}) {\n  const params = new URLSearchParams({ page: String(page) })\n  if (status) params.set('status', status)\n  return data(await api.get(`/admin/opname-stok?${params}`))\n}\n\nexport async function ambilDetailOpname(id) {\n  return data(await api.get(`/admin/opname-stok/${id}`))\n}\n\nexport async function buatOpname(produkIds, catatan = '') {\n  return data(await api.post('/admin/opname-stok', { produk_ids: produkIds, catatan }))\n}\n\nexport async function simpanHitungFisik(id, items) {\n  return api.put(`/admin/opname-stok/${id}`, { items })\n}\n\nexport async function selesaikanOpname(id) {\n  return api.post(`/admin/opname-stok/${id}/selesai`, {})\n}\n\nexport async function batalkanOpname(id) {\n  return api.post(`/admin/opname-stok/${id}/batalkan`, {})\n}\n\nexport async function keluarkanBarang(dataPengeluaran) {\n  return api.post('/admin/opname-stok/pengeluaran', dataPengeluaran)\n}\n\nexport async function ringkasanPengeluaran() {\n  return data(await api.get('/admin/opname-stok/ringkasan-pengeluaran'))\n}\n", "frontend/src/pages/admin/StockOpnamePage.jsx": "import { useCallback, useEffect, useMemo, useState } from 'react'\nimport { Link } from 'react-router-dom'\nimport AdminLayout from './AdminLayout'\nimport ManagementLayout from './ManagementLayout'\nimport { getProduk } from '../../services/produkService'\nimport {\n  ambilDaftarOpname, ambilDetailOpname, buatOpname, simpanHitungFisik,\n  selesaikanOpname, batalkanOpname, keluarkanBarang, ringkasanPengeluaran,\n} from '../../services/opnameStokService'\n\nconst format = (value) => new Intl.NumberFormat('id-ID').format(Number(value ?? 0))\nconst statusLabel = { draft: 'Draft', selesai: 'Selesai', dibatalkan: 'Dibatalkan' }\nconst tanggal = (value) => value ? new Date(value).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) : '—'\nconst safeError = (err) => err?.data?.message || err?.message || 'Terjadi kesalahan. Silakan coba lagi.'\n\nfunction StockOpnamePage({ readOnly = false }) {\n  const [produk, setProduk] = useState([])\n  const [sesi, setSesi] = useState([])\n  const [total, setTotal] = useState(0)\n  const [page, setPage] = useState(1)\n  const [lastPage, setLastPage] = useState(1)\n  const [filterStatus, setFilterStatus] = useState('')\n  const [pilihId, setPilihId] = useState(null)\n  const [detail, setDetail] = useState(null)\n  const [fisik, setFisik] = useState({})\n  const [catatanDetail, setCatatanDetail] = useState({})\n  const [dipilih, setDipilih] = useState([])\n  const [catatanSesi, setCatatanSesi] = useState('')\n  const [ringkasan, setRingkasan] = useState(null)\n  const [jenisKeluar, setJenisKeluar] = useState('rusak')\n  const [produkKeluar, setProdukKeluar] = useState('')\n  const [jumlahKeluar, setJumlahKeluar] = useState('')\n  const [tanggalKedaluwarsa, setTanggalKedaluwarsa] = useState('')\n  const [alasanKeluar, setAlasanKeluar] = useState('')\n  const [loading, setLoading] = useState(true)\n  const [busy, setBusy] = useState(false)\n  const [pesan, setPesan] = useState('')\n  const [error, setError] = useState('')\n  const [revision, setRevision] = useState(0)\n\n  const refresh = useCallback(() => setRevision((v) => v + 1), [])\n\n  useEffect(() => {\n    let aktif = true\n    setLoading(true)\n    setError('')\n    Promise.all([getProduk(), ambilDaftarOpname({ status: filterStatus, page }), ringkasanPengeluaran()])\n      .then(([items, result, summary]) => {\n        if (!aktif) return\n        setProduk(Array.isArray(items) ? items : [])\n        setSesi(Array.isArray(result?.items) ? result.items : [])\n        setTotal(Number(result?.total || 0))\n        setLastPage(Number(result?.last_page || 1))\n        setRingkasan(summary)\n      })\n      .catch((err) => { if (aktif) setError(safeError(err)) })\n      .finally(() => { if (aktif) setLoading(false) })\n    return () => { aktif = false }\n  }, [filterStatus, page, revision])\n\n  useEffect(() => {\n    if (!pilihId) { setDetail(null); return undefined }\n    let aktif = true\n    setDetail(null)\n    ambilDetailOpname(pilihId)\n      .then((data) => {\n        if (!aktif) return\n        setDetail(data)\n        setFisik(Object.fromEntries((data?.items || []).map((item) => [item.id, item.stok_fisik === null ? '' : String(item.stok_fisik)])))\n        setCatatanDetail(Object.fromEntries((data?.items || []).map((item) => [item.id, item.catatan || ''])))\n      })\n      .catch((err) => { if (aktif) setError(safeError(err)) })\n    return () => { aktif = false }\n  }, [pilihId, revision])\n\n  const pilihanProduk = useMemo(() => produk.find((p) => String(p.id) === produkKeluar), [produk, produkKeluar])\n  const daftarProduk = useMemo(() => [...produk].sort((a, b) => (a.nama || '').localeCompare(b.nama || '', 'id')), [produk])\n\n  const jalankan = async (pekerjaan, sukses, { tutupDetail = false } = {}) => {\n    setBusy(true); setError(''); setPesan('')\n    try {\n      await pekerjaan()\n      if (tutupDetail) { setPilihId(null); setDetail(null) }\n      setPesan(sukses)\n      refresh()\n    } catch (err) { setError(safeError(err)) }\n    finally { setBusy(false) }\n  }\n\n  const buatSesi = (event) => {\n    event.preventDefault()\n    if (!dipilih.length) { setError('Pilih setidaknya satu produk untuk dihitung.'); return }\n    jalankan(async () => {\n      const result = await buatOpname(dipilih.map(Number), catatanSesi)\n      setDipilih([]); setCatatanSesi(''); setPilihId(result.id)\n      setPage(1); setFilterStatus('')\n    }, 'Draft stock opname dibuat. Isi stok fisik dan simpan penghitungan.')\n  }\n\n  const simpanFisik = (event) => {\n    event.preventDefault()\n    const items = (detail?.items || []).map((item) => ({\n      id: item.id,\n      stok_fisik: Number(fisik[item.id]),\n      catatan: catatanDetail[item.id] || '',\n    }))\n    if (items.some((item) => fisik[item.id] === '' || !Number.isSafeInteger(item.stok_fisik) || item.stok_fisik < 0 || item.stok_fisik > 4294967295)) {\n      setError('Isi semua stok fisik dengan bilangan bulat nonnegatif.'); return\n    }\n    jalankan(() => simpanHitungFisik(detail.id, items), 'Hasil hitung fisik disimpan sebagai draft. Stok sistem belum berubah.')\n  }\n\n  const finalkan = () => {\n    if (!window.confirm('Yakin finalisasi stock opname? Stok produk yang berbeda akan disesuaikan secara permanen.')) return\n    jalankan(() => selesaikanOpname(detail.id), 'Stock opname selesai. Selisih stok masuk ke Riwayat Mutasi.', { tutupDetail: true })\n  }\n\n  const batalkan = () => {\n    if (!window.confirm('Batalkan draft ini? Tidak ada perubahan stok.')) return\n    jalankan(() => batalkanOpname(detail.id), 'Sesi dibatalkan tanpa mengubah stok.', { tutupDetail: true })\n  }\n\n  const simpanPengeluaran = (event) => {\n    event.preventDefault()\n    if (!pilihanProduk) { setError('Pilih produk terlebih dahulu.'); return }\n    const jumlah = Number(jumlahKeluar)\n    const stok = Number(pilihanProduk.stok ?? 0)\n    if (!Number.isSafeInteger(jumlah) || jumlah < 1 || jumlah > stok) {\n      setError('Jumlah keluar harus lebih dari nol dan tidak melebihi stok tersedia.'); return\n    }\n    if (alasanKeluar.trim().length < 8) { setError('Alasan minimal delapan karakter.'); return }\n    if (jenisKeluar === 'kedaluwarsa' && !tanggalKedaluwarsa) { setError('Isi tanggal kedaluwarsa.'); return }\n    jalankan(async () => {\n      await keluarkanBarang({\n        jenis: jenisKeluar,\n        produk_id: Number(pilihanProduk.id),\n        stok_sebelum: stok,\n        jumlah,\n        keterangan: alasanKeluar.trim(),\n        ...(jenisKeluar === 'kedaluwarsa' ? { tanggal_kedaluwarsa: tanggalKedaluwarsa } : {}),\n      })\n      setJumlahKeluar(''); setAlasanKeluar(''); setTanggalKedaluwarsa(''); setProdukKeluar('')\n    }, 'Barang berhasil dikeluarkan dari stok dan tercatat di Mutasi Stok.')\n  }\n\n  const konten = (\n    <>\n      <div className=\"admin-form-toolbar\">\n        <Link to={readOnly ? '/management/dashboard' : '/admin/mutasi-stok'} className=\"admin-btn admin-btn-ghost\">\n          ← {readOnly ? 'Dashboard Management' : 'Riwayat Mutasi Stok'}\n        </Link>\n        <button type=\"button\" className=\"admin-btn admin-btn-ghost\" onClick={refresh} disabled={busy || loading}>Muat ulang</button>\n      </div>\n      {error && <div className=\"admin-alert\" role=\"alert\">{error}</div>}\n      {pesan && <div className=\"admin-alert admin-alert-success\" role=\"status\">{pesan}</div>}\n\n      <section className=\"management-section\" id=\"ringkasan-opname\">\n        <h2 className=\"display-font\">Stock Opname & Barang Tidak Layak Jual</h2>\n        <p className=\"management-data-note\">Hitung stok fisik, bandingkan dengan database, lalu finalisasi hanya setelah data dipastikan benar. Semua penyesuaian akan tercatat sebagai mutasi.</p>\n        <div className=\"admin-stats\">\n          <div className=\"admin-stat\"><span className=\"admin-stat-value display-font\">{loading ? '…' : format(ringkasan?.rusak?.unit)}</span><span className=\"admin-stat-label\">Barang Rusak Bulan Ini (pcs)</span></div>\n          <div className=\"admin-stat\"><span className=\"admin-stat-value display-font\">{loading ? '…' : format(ringkasan?.kedaluwarsa?.unit)}</span><span className=\"admin-stat-label\">Barang Kedaluwarsa Bulan Ini (pcs)</span></div>\n          <div className=\"admin-stat\"><span className=\"admin-stat-value display-font\">{loading ? '…' : format(total)}</span><span className=\"admin-stat-label\">Sesi Opname (filter)</span></div>\n        </div>\n      </section>\n\n      {!readOnly && (\n        <section className=\"admin-card management-section\" id=\"buat-opname\">\n          <div className=\"admin-card-head\"><h2 className=\"display-font\">Buat Sesi Stock Opname</h2></div>\n          <p className=\"management-data-note\">Pilih maksimal 100 produk per sesi. Stok database disimpan sebagai acuan awal; belum ada perubahan stok.</p>\n          <form className=\"admin-form\" onSubmit={buatSesi}>\n            <label className=\"admin-field\"><span>Catatan sesi (opsional)</span><input maxLength={1000} value={catatanSesi} onChange={(e) => setCatatanSesi(e.target.value)} placeholder=\"Contoh: Pengecekan stok setelah tutup toko\" /></label>\n            <fieldset style={{ border: 0, padding: 0, margin: 0 }}>\n              <legend className=\"admin-field\">Pilih produk ({dipilih.length} dipilih)</legend>\n              <div style={{ maxHeight: 200, overflowY: 'auto', border: '1px solid #ddd', borderRadius: 8, padding: 12 }}>\n                {daftarProduk.map((item) => (\n                  <label key={item.id} style={{ display: 'flex', alignItems: 'center', gap: 8, padding: '4px 0' }}>\n                    <input type=\"checkbox\" checked={dipilih.includes(String(item.id))}\n                      disabled={busy || (!dipilih.includes(String(item.id)) && dipilih.length >= 100)}\n                      onChange={(e) => setDipilih((old) => e.target.checked ? [...old, String(item.id)] : old.filter((id) => id !== String(item.id)))} />\n                    {item.nama} — Stok sistem: {format(item.stok)} pcs\n                  </label>\n                ))}\n              </div>\n            </fieldset>\n            <div className=\"admin-form-actions\"><button className=\"admin-btn admin-btn-primary\" type=\"submit\" disabled={busy || !dipilih.length}>Buat Draft Opname</button></div>\n          </form>\n        </section>\n      )}\n\n      <section className=\"admin-card management-section\" id=\"daftar-opname\">\n        <div className=\"admin-card-head\"><h2 className=\"display-font\">Daftar Sesi Stock Opname</h2><span>{format(total)} sesi</span></div>\n        <div className=\"admin-form-grid\"><label className=\"admin-field\"><span>Filter status</span>\n          <select value={filterStatus} onChange={(e) => { setPage(1); setFilterStatus(e.target.value); setPilihId(null) }}>\n            <option value=\"\">Semua status</option><option value=\"draft\">Draft</option><option value=\"selesai\">Selesai</option><option value=\"dibatalkan\">Dibatalkan</option>\n          </select>\n        </label></div>\n        {loading ? <p className=\"admin-empty\">Memuat sesi…</p> : !sesi.length ? <p className=\"admin-empty\">Belum ada sesi untuk filter ini.</p> :\n          <div className=\"admin-table-wrap\"><table className=\"admin-table\">\n            <thead><tr><th>ID</th><th>Waktu (WIB)</th><th>Status</th><th>Produk</th><th>Petugas</th><th>Aksi</th></tr></thead>\n            <tbody>{sesi.map((item) => <tr key={item.id}>\n              <td>#{item.id}</td><td>{tanggal(item.dibuat_pada)}</td><td>{statusLabel[item.status] || item.status}</td>\n              <td>{format(item.jumlah_produk)}</td><td>{item.dibuat_oleh}</td>\n              <td><button type=\"button\" className=\"admin-btn admin-btn-ghost\" disabled={busy} onClick={() => setPilihId(item.id)}>Lihat detail</button></td>\n            </tr>)}</tbody>\n          </table></div>}\n        <div className=\"admin-form-actions\">\n          <button type=\"button\" className=\"admin-btn admin-btn-ghost\" disabled={page <= 1 || loading} onClick={() => setPage((v) => v - 1)}>Sebelumnya</button>\n          <span>Halaman {page} dari {lastPage}</span>\n          <button type=\"button\" className=\"admin-btn admin-btn-ghost\" disabled={page >= lastPage || loading} onClick={() => setPage((v) => v + 1)}>Berikutnya</button>\n        </div>\n      </section>\n\n      {pilihId && !detail && <p className=\"admin-empty\">Memuat detail opname…</p>}\n      {detail && (\n        <section className=\"admin-card management-section\" id=\"detail-opname\">\n          <div className=\"admin-card-head\"><h2 className=\"display-font\">Detail Opname #{detail.id}</h2><span>{statusLabel[detail.status] || detail.status}</span></div>\n          <p className=\"management-data-note\">Dibuat {tanggal(detail.dibuat_pada)} oleh {detail.dibuat_oleh}. {detail.catatan || ''}</p>\n          <form className=\"admin-form\" onSubmit={simpanFisik}>\n            <div className=\"admin-table-wrap\"><table className=\"admin-table\">\n              <thead><tr><th>Produk</th><th>Stok saat draft</th><th>Stok sekarang</th><th>Stok fisik</th><th>Selisih</th><th>Catatan</th></tr></thead>\n              <tbody>{(detail.items || []).map((item) => {\n                const val = fisik[item.id]\n                const nilai = val === '' || val == null ? null : Number(val)\n                const selisih = nilai === null || !Number.isFinite(nilai) ? null : nilai - Number(item.stok_sistem)\n                const bisaUbah = detail.status === 'draft' && !readOnly\n                return <tr key={item.id}>\n                  <td>{item.nama_produk}<small className=\"admin-sub\">{item.barcode || ''}</small></td>\n                  <td>{format(item.stok_sistem)}</td><td>{format(item.stok_saat_ini)}</td>\n                  <td>{bisaUbah ? <input aria-label={`Stok fisik ${item.nama_produk}`} type=\"number\" min=\"0\" max=\"4294967295\" step=\"1\" required value={val ?? ''} onChange={(e) => setFisik((old) => ({ ...old, [item.id]: e.target.value }))} /> : (item.stok_fisik == null ? '—' : format(item.stok_fisik))}</td>\n                  <td>{selisih === null ? '—' : `${selisih > 0 ? '+' : ''}${format(selisih)}`}</td>\n                  <td>{bisaUbah ? <input maxLength=\"400\" aria-label={`Catatan ${item.nama_produk}`} value={catatanDetail[item.id] ?? ''} onChange={(e) => setCatatanDetail((old) => ({ ...old, [item.id]: e.target.value }))} /> : (item.catatan || '—')}</td>\n                </tr>\n              })}</tbody>\n            </table></div>\n            {!readOnly && detail.status === 'draft' && (\n              <div className=\"admin-form-actions\">\n                <button type=\"submit\" className=\"admin-btn admin-btn-primary\" disabled={busy}>Simpan Hasil Hitung</button>\n                <button type=\"button\" className=\"admin-btn admin-btn-primary\" disabled={busy} onClick={finalkan}>Finalisasi Stok</button>\n                <button type=\"button\" className=\"admin-btn admin-btn-ghost\" disabled={busy} onClick={batalkan}>Batalkan Sesi</button>\n              </div>\n            )}\n          </form>\n          {!readOnly && detail.status === 'draft' && <p className=\"management-data-note\">Simpan hasil hitung terlebih dahulu sebelum finalisasi. Jika stok berubah sejak draft dibuat, sistem menolak finalisasi agar stok tidak tertimpa.</p>}\n        </section>\n      )}\n\n      {!readOnly && (\n        <section className=\"admin-card management-section\" id=\"pengeluaran-barang\">\n          <div className=\"admin-card-head\"><h2 className=\"display-font\">Barang Rusak / Kedaluwarsa</h2></div>\n          <p className=\"management-data-note\">Kurangi stok barang tidak layak jual. Tindakan ini dicatat di Riwayat Mutasi. Untuk kedaluwarsa, tanggal diisi manual karena belum ada pencatatan batch.</p>\n          <form className=\"admin-form\" onSubmit={simpanPengeluaran}>\n            <div className=\"admin-form-grid\">\n              <label className=\"admin-field\"><span>Jenis pengeluaran</span><select value={jenisKeluar} onChange={(e) => setJenisKeluar(e.target.value)}><option value=\"rusak\">Rusak</option><option value=\"kedaluwarsa\">Kedaluwarsa</option></select></label>\n              <label className=\"admin-field\"><span>Produk</span><select value={produkKeluar} onChange={(e) => { setProdukKeluar(e.target.value); setJumlahKeluar('') }} required><option value=\"\">Pilih produk</option>{daftarProduk.map((item) => <option key={item.id} value={item.id}>{item.nama} — Stok {format(item.stok)}</option>)}</select></label>\n              <label className=\"admin-field\"><span>Jumlah keluar (pcs)</span><input type=\"number\" min=\"1\" step=\"1\" max={pilihanProduk?.stok ?? 0} value={jumlahKeluar} onChange={(e) => setJumlahKeluar(e.target.value)} required /></label>\n              {jenisKeluar === 'kedaluwarsa' && <label className=\"admin-field\"><span>Tanggal kedaluwarsa produk</span><input type=\"date\" required value={tanggalKedaluwarsa} onChange={(e) => setTanggalKedaluwarsa(e.target.value)} /></label>}\n            </div>\n            <label className=\"admin-field\"><span>Alasan / kondisi (wajib)</span><textarea rows={2} minLength={8} maxLength={450} value={alasanKeluar} onChange={(e) => setAlasanKeluar(e.target.value)} placeholder=\"Contoh: Kemasan rusak dan produk tidak layak dijual\" required /></label>\n            <div className=\"admin-form-actions\"><button type=\"submit\" className=\"admin-btn admin-btn-primary\" disabled={busy || !pilihanProduk}>Simpan Pengeluaran Stok</button></div>\n          </form>\n        </section>\n      )}\n    </>\n  )\n\n  return readOnly ? <ManagementLayout>{konten}</ManagementLayout> : <AdminLayout title=\"Stock Opname & Barang Rusak\">{konten}</AdminLayout>\n}\n\nexport default StockOpnamePage\n"}
const resources = Object.entries(embedded).map(([relative, contents]) => {
  const isBackend = relative.startsWith('backend/')
  const local = relative.slice(isBackend ? 'backend/'.length : 'frontend/'.length)
  return { file: path.join(isBackend ? backend : frontend, ...local.split('/')), contents }
})

function stop(message) { throw new Error(message + '\nTidak ada perubahan yang disimpan.') }
function has(text, needle) { return text.includes(needle) }
function main() {
  console.log('\n' + VERSION)
  console.log('Lokasi script:', __filename)
  console.log('Root proyek: ', root)
  console.log('Backend:     ', backend)
  console.log('Frontend:    ', frontend)
  const missing = []
  for (const filename of Object.values(files)) {
    const status = fs.existsSync(filename) ? 'OK    ' : 'HILANG'
    console.log(status, filename)
    if (status === 'HILANG') missing.push(filename)
  }
  for (const item of resources) console.log((fs.existsSync(item.file) ? 'SUDAH ' : 'BARU  ') + ' ', item.file)
  if (missing.length) {
    stop('File inti tidak ditemukan. Periksa folder root dan modul Mutasi Stok:\n' + missing.join('\n'))
  }
  const original = Object.fromEntries(Object.entries(files).map(([k, filename]) => [k, fs.readFileSync(filename, 'utf8')]))
  const output = { ...original }
  if (!/['"]\/admin\/mutasi-stok['"]/.test(output.api)) stop('Route Mutasi Stok belum ditemukan di routes/api.php.')
  if (!/\bRiwayatStokPage\b/.test(output.app)) stop('RiwayatStokPage belum didaftarkan di App.jsx.')

  // Jika sebagian route sudah terpasang, hentikan daripada membuat duplikasi.
  const routes = [
    ['get', '/admin/opname-stok', 'index', 'can:view-management-dashboard'],
    ['get', '/admin/opname-stok/ringkasan-pengeluaran', 'ringkasanPengeluaran', 'can:view-management-dashboard'],
    ['get', '/admin/opname-stok/{opnameStok}', 'show', 'can:view-management-dashboard'],
    ['post', '/admin/opname-stok', 'store', 'can:manage-admin'],
    ['put', '/admin/opname-stok/{opnameStok}', 'update', 'can:manage-admin'],
    ['post', '/admin/opname-stok/{opnameStok}/selesai', 'selesai', 'can:manage-admin'],
    ['post', '/admin/opname-stok/{opnameStok}/batalkan', 'batalkan', 'can:manage-admin'],
    ['post', '/admin/opname-stok/pengeluaran', 'pengeluaran', 'can:manage-admin'],
  ]
  const already = routes.map(([method, uri]) => new RegExp('Route::' + method + '\\s*\\(\\s*[\\\'\"]' + uri.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '[\\\'\"]').test(output.api))
  const howMany = already.filter(Boolean).length
  if (howMany > 0 && howMany < routes.length) stop('Route Stock Opname sudah terpasang SEBAGIAN di api.php. Perlu pemeriksaan manual, agar tidak menduplikasi endpoint.')
  if (howMany === 0 && /StockOpnameController|\/admin\/opname-stok/.test(output.api)) stop('Ada potongan instalasi Stock Opname di api.php. Periksa sebelum menjalankan ulang.')
  if (howMany === 0) {
    if (!output.api.includes('use App\\Http\\Controllers\\Api\\StockOpnameController;')) {
      output.api = output.api.replace(/^<\?php(?:\r?\n)/, '$&\nuse App\\Http\\Controllers\\Api\\StockOpnameController;\n')
      if (!output.api.includes('use App\\Http\\Controllers\\Api\\StockOpnameController;')) stop('Tidak menemukan pembuka PHP untuk menambahkan import controller.')
    }
    output.api += '\n// KUKI STOCK OPNAME — Admin/Owner baca, Admin tulis\n'
    for (const [method,uri,action,permission] of routes) {
      output.api += `Route::${method}('${uri}', [StockOpnameController::class, '${action}'])->middleware(['auth:sanctum', '${permission}']);\n`
    }
  }

  const reactRouteAdmin = /<Route\s+path\s*=\s*['"]\/admin\/opname-stok['"]/.test(output.app)
  const reactRouteOwner = /<Route\s+path\s*=\s*['"]\/management\/opname-stok['"]/.test(output.app)
  if (reactRouteAdmin !== reactRouteOwner) stop('Hanya satu route React Stock Opname yang sudah ada. Periksa src/App.jsx secara manual.')
  if (!/import\s+StockOpnamePage\s+from\s+['"]\.\/pages\/admin\/StockOpnamePage(?:\.jsx)?['"]/.test(output.app)) {
    const riwayatImport = /import\s+RiwayatStokPage\s+from\s+['"]\.\/pages\/admin\/RiwayatStokPage(?:\.jsx)?['"]/
    const match = output.app.match(riwayatImport)
    if (!match) stop('Import RiwayatStokPage di App.jsx tidak ditemukan.')
    output.app = output.app.replace(match[0], match[0] + "\nimport StockOpnamePage from './pages/admin/StockOpnamePage'")
  }
  if (!reactRouteAdmin) {
    if (!/\bAdminRoute\b/.test(output.app) || !/\bManagementRoute\b/.test(output.app)) stop('AdminRoute/ManagementRoute tidak ditemukan di App.jsx.')
    const wildcard = /(^[ \t]*)<Route\s+path\s*=\s*['"]\*['"]/m
    const match = output.app.match(wildcard)
    if (!match) stop('Route wildcard (*) tidak ditemukan di App.jsx.')
    const indent = match[1] || '        '
    const newRoutes = `${indent}<Route path="/admin/opname-stok" element={<AdminRoute><StockOpnamePage /></AdminRoute>} />\n` +
      `${indent}<Route path="/management/opname-stok" element={<ManagementRoute><StockOpnamePage readOnly /></ManagementRoute>} />\n`
    output.app = output.app.replace(match[0], newRoutes + match[0])
  }

  // Menambah jenis mutasi dengan pencocokan selektif; tidak mengganti controller secara penuh.
  const validType = /in:stok_awal,produksi,koreksi(?:,opname,rusak,kedaluwarsa)?/g
  if (!/in:stok_awal,produksi,koreksi,opname,rusak,kedaluwarsa/.test(output.mutasi)) {
    if (!validType.test(output.mutasi)) stop('Validasi jenis mutasi tidak cocok pada MutasiStokController.php.')
    output.mutasi = output.mutasi.replace('in:stok_awal,produksi,koreksi', 'in:stok_awal,produksi,koreksi,opname,rusak,kedaluwarsa')
  }
  if (!/\bopname:\s*['"]Stock opname['"]/.test(output.riwayat)) {
    const label = /koreksi:\s*['"]Koreksi stok['"],?/
    if (!label.test(output.riwayat)) stop('Label Koreksi stok tidak ditemukan di RiwayatStokPage.jsx.')
    output.riwayat = output.riwayat.replace(label, `$&\n  opname: 'Stock opname',\n  rusak: 'Barang rusak',\n  kedaluwarsa: 'Barang kedaluwarsa',`)
  }
  if (!output.riwayat.includes('>Stock Opname</Link>')) {
    const toolbar = /(<div\s+className=['"]admin-form-toolbar['"]>[\s\S]*?<Link[\s\S]*?<\/Link>)/
    if (!toolbar.test(output.riwayat) || !/\breadOnly\b/.test(output.riwayat)) stop('Toolbar halaman Riwayat Stok berbeda, tidak aman menyisipkan link otomatis.')
    output.riwayat = output.riwayat.replace(toolbar, `$1\n        <Link className="admin-btn admin-btn-ghost" to={readOnly ? '/management/opname-stok' : '/admin/opname-stok'}>Stock Opname</Link>`)
  }

  const plan = []
  for (const [k,filename] of Object.entries(files)) {
    if (output[k] !== original[k]) plan.push({filename, contents:output[k], existed:true})
  }
  for (const item of resources) {
    if (!fs.existsSync(item.file)) plan.push({filename:item.file, contents:item.contents, existed:false})
  }
  if (!plan.length) { console.log('\nSudah terpasang. Tidak ada yang perlu diubah.'); return }
  console.log('\nPerubahan yang diperlukan:', plan.length, 'file.')
  if (cek) {
    for (const p of plan) console.log('RENCANA', p.existed ? 'perbarui:' : 'tambahkan:', p.filename)
    console.log('Mode --cek: validasi selesai. Tidak ada file yang diubah.')
    return
  }
  const stamp = new Date().toISOString().replace(/[:.]/g, '-')
  // Simpan cadangan asli terlebih dahulu, lalu tulis file. Rollback jika ada kesalahan tulis.
  const backups = new Map()
  const added = []
  try {
    for (const item of plan.filter(p => p.existed)) {
      const bak = item.filename + '.bak-opname-' + stamp
      fs.copyFileSync(item.filename, bak, fs.constants.COPYFILE_EXCL)
      backups.set(item.filename, bak)
    }
    for (const item of plan) {
      fs.mkdirSync(path.dirname(item.filename), {recursive:true})
      if (item.existed) fs.writeFileSync(item.filename, item.contents, 'utf8')
      else { fs.writeFileSync(item.filename, item.contents, {encoding:'utf8', flag:'wx'}); added.push(item.filename) }
      console.log(item.existed ? 'Diperbarui:' : 'Ditambahkan:', item.filename)
    }
  } catch(error) {
    for (const filename of added) { try { fs.unlinkSync(filename) } catch {} }
    for (const [filename,bak] of backups) { try { fs.copyFileSync(bak,filename) } catch(e) { console.error('PERLU PEMULIHAN MANUAL:',filename,bak) } }
    throw new Error('Pemasangan dibatalkan; file hasil perubahan dicoba dipulihkan dari backup. ' + error.message)
  }
  console.log('\nPemasangan selesai. Di backend: php artisan migrate; php artisan route:list --path=opname-stok')
  console.log('Di frontend: npm run build')
}
try { main() } catch(error) { console.error('\nERROR:', error.message); process.exitCode=1 }
