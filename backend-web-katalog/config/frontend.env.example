# Salin manual ke web-katalog/.env.local, isi nilai koordinat RESMI hasil verifikasi.
# JANGAN MENARUH HEIGIT_API_KEY DI VITE_*. Kunci API harus hanya di Laravel.
VITE_KUKI_STORE_LAT=
VITE_KUKI_STORE_LNG=
VITE_KUKI_STORE_NAME="Kuki Bakehouse"
VITE_KUKI_STORE_ADDRESS=""
# Kosongkan bila Vite proxy / deployment mengarahkan /api ke Laravel.
VITE_KUKI_MAP_API_BASE_URL=
# Provider tile dapat diganti sesuai kebijakan, kebutuhan lalu lintas, dan lisensi.
VITE_KUKI_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
